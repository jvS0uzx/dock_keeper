# Configuracao do agente de estacao do vd_stats.
#
# Copie para /etc/vd-agent.env e restrinja o acesso — o token vale para
# qualquer maquina que o tenha:
#   sudo chmod 600 /etc/vd-agent.env
#
# Valores sem espacos; aspas sao aceitas pelo systemd e removidas na leitura.

# URL do painel central (obrigatoria). Sem barra no final.
AGENT_SERVER_URL="https://painel.exemplo.com"

# Convite de enrollment, emitido no painel em POST /api/enroll/tokens por um
# administrador global. E a forma RECOMENDADA de identificar a maquina.
#
# No primeiro boot o agente troca o convite por uma credencial propria, amarrada
# a uma unidade, e a grava em /var/lib/vd-agent/credential.json com modo 0600.
# Depois disso esta variavel pode sair daqui: o convite ja foi queimado e nao
# serve para mais nada, nem para quem o interceptar.
#
# O convite vale 24 horas e so pode ser usado UMA vez.
AGENT_ENROLL_TOKEN=""

# Token compartilhado — EM DESCONTINUACAO. Mesmo valor de AGENT_INGEST_TOKEN no
# .env do painel.
#
# E o mesmo segredo em todos os agentes de todas as unidades, e quem o tem
# declara a unidade que quiser no corpo do envio: uma estacao comprometida em
# qualquer filial forja inventario de outra e injeta metrica falsa que dispara ou
# silencia alerta. Continua aceito durante a transicao, com aviso no log.
#
# Use so quando o painel ainda nao suporta enrollment. Preencha AGENT_ENROLL_TOKEN
# OU este, nao os dois — com os dois, o enrollment vence.
AGENT_TOKEN=""

# Codigo da unidade onde a estacao fica.
#
# So faz efeito no modo AGENT_TOKEN compartilhado. Com credencial propria a
# unidade sai da CREDENCIAL, e este campo passa a ser apenas conferido: declarar
# unidade diferente da credencial faz o painel recusar o envio inteiro com 409 e
# registrar a tentativa na auditoria.
AGENT_SITE=""

# Segundos entre envios (opcional, padrao 5).
AGENT_INTERVAL="5"

# Nome com que a maquina aparece no painel (opcional, padrao: hostname do
# sistema). Util quando o hostname local e generico, ex: "PC-FINANCEIRO-02".
#AGENT_HOSTNAME=""
