# ==========================================
# DockKeeper - Configuração de Ambiente
# ==========================================
# Este arquivo guarda segredos. Depois de preencher, restrinja o acesso:
#   chmod 600 .env frontend/.env

# ------------------------------------------
# Banco de Dados
# ------------------------------------------
# A porta e 5433, nao 5432: o docker-compose.yml publica o Postgres do container
# em 5433 no host, para nao conflitar com um Postgres ja instalado na maquina.
# Este arquivo dizia 5432 e o compose dizia 5433 — quem seguisse os dois
# literalmente conectava na porta errada sem receber pista do motivo.
DATABASE_URL="host=localhost user=SEU_USER password=SUA_SENHA dbname=vd_stats port=5433 sslmode=disable TimeZone=UTC"

# As quatro abaixo sao lidas pelo docker-compose.yml, nao pelo backend. Sem
# POSTGRES_PASSWORD o `docker compose up` falha na cara de quem copiou este
# arquivo, porque o compose a declara como obrigatoria.
POSTGRES_PASSWORD=""
POSTGRES_USER="postgres"
POSTGRES_DB="vd_stats"
POSTGRES_PORT="5433"

# Porta em que o painel (frontend) fica acessivel quando sobe pelo compose.
PANEL_PORT="8081"

# Pool de conexões. Sem teto, as goroutines de coleta somadas aos handlers HTTP
# esgotam o max_connections do Postgres com "sorry, too many clients". O teto
# precisa ser menor que o max_connections do servidor, contando todas as
# réplicas do painel.
DB_MAX_OPEN_CONNS="20"
DB_MAX_IDLE_CONNS="5"
DB_CONN_MAX_LIFETIME="30m"

# ------------------------------------------
# API (obrigatório)
# ------------------------------------------
# Token exigido em toda rota da API. A API se recusa a subir sem ele: o painel
# comanda SSH como root nas VPS, então uma porta aberta entrega o cluster.
# Gere com: openssl rand -hex 32
API_TOKEN=""

# Origens liberadas no CORS, separadas por vírgula. O padrão é apenas
# http://localhost:5173 (Vite em dev). Em produção aponte para o domínio real.
ALLOWED_ORIGINS="http://localhost:5173"

# Autoriza a API a ler X-Real-IP / X-Forwarded-For para descobrir a origem da
# requisição. Ligue SOMENTE com proxy reverso à frente: sem ele o cabeçalho vem
# do próprio cliente e o limite de tentativa de login por IP vira enfeite.
#
# Ligando, o nginx precisa de:
#   proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
# Sem essa linha o parque inteiro conta num balde só, e um atacante insistente
# tranca a tela de login para todos os usuários.
TRUST_PROXY_HEADERS="false"

# ------------------------------------------
# Limite de tentativa no login
# ------------------------------------------
# A rota de login é pública e cada tentativa gasta um bcrypt de custo 10
# (60-100 ms de CPU), o que a torna também negação de serviço barata. Passado o
# teto, a resposta é 429 antes de conferir a senha.
LOGIN_RATE_WINDOW="15m"
LOGIN_RATE_MAX_IP="30"
LOGIN_RATE_MAX_USER="8"

# ------------------------------------------
# Autenticação SSH para conexão
# ------------------------------------------
# Esta chave será usada para conectar em TODAS as VPS cadastradas pelo painel Web
SSH_KEY_PATH="~/.ssh/sua_chave_ssh"

# Arquivo known_hosts usado para validar a identidade das VPS. OBRIGATÓRIO:
# a API se recusa a subir sem ele. Antes o painel caía em silêncio para "aceita
# qualquer host key", e um painel que roda comando como root por SSH nessa
# condição está exposto a man-in-the-middle.
# Popule com: ssh-keyscan -H IP_DA_VPS >> ~/.ssh/known_hosts
SSH_KNOWN_HOSTS="~/.ssh/known_hosts"

# Desliga a verificação de host key de propósito, com aviso alto no log.
# Existe para laboratório e primeira instalação; não use em produção.
SSH_INSECURE_HOST_KEY="false"

# ------------------------------------------
# Agente de coleta push (cmd/agent) — opcional
# ------------------------------------------
# EM DESCONTINUACAO. Um unico token para todos os agentes e coletores de todas
# as unidades: qualquer portador declarava a unidade que quisesse no corpo do
# envio, entao uma estacao comprometida em qualquer filial forjava inventario de
# outra e injetava metrica falsa que dispara ou silencia alerta.
#
# O substituto e a credencial por dispositivo (item S7): o administrador emite um
# convite de uso unico em POST /api/enroll/tokens, o instalador o troca por uma
# credencial propria em POST /api/enroll, e a unidade passa a sair da credencial
# em vez do corpo. Revogar um dispositivo em DELETE /api/devices nao afeta os
# demais.
#
# Continua aceito durante a transicao, com aviso no log a cada uso. Sem ele E sem
# credencial apresentada, a ingestao fica desligada (fail-closed).
AGENT_INGEST_TOKEN=""

# ------------------------------------------
# Alertas no Telegram — opcional
# ------------------------------------------
# Sem as duas variáveis os alertas só vão para o log do processo.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# ------------------------------------------
# Inventario da rede local (2o painel) - opcional
# ------------------------------------------
# Faixas varridas, separadas por virgula. So aceita rede privada (RFC1918):
# o recurso existe para inventariar a rede da propria secao, nao redes de
# terceiros. Vazio = inventario desligado.
DISCOVERY_CIDRS="192.168.0.0/24"

# Intervalo entre varreduras, em minutos (padrao 15).
DISCOVERY_INTERVAL_MIN="15"

# Portas sondadas. Vazio usa a lista padrao:
# 22,80,135,139,443,445,3389,8080,9100
DISCOVERY_PORTS=""

# Codigo da unidade (tabela sites) a que esta varredura pertence, espelhando o
# COLLECTOR_SITE do coletor remoto. Sem ele os hosts descobertos ficam sem
# unidade — e, como a planta baixa exige unidade, nao podem ser posicionados no
# mapa sem classificacao manual um a um.
#
# A unidade so e aplicada a quem ainda nao foi classificado a mao: o painel
# marca uma trava (site_locked) quando o operador move um host, e a varredura
# respeita essa escolha. O mesmo vale para o tipo de equipamento
# (device_type_locked) — corrigir "Desconhecido" para "Impressora" no painel
# nao e mais desfeito no ciclo seguinte.
#
# Unidade inexistente e apenas registrada no log; a varredura continua rodando.
DISCOVERY_SITE=""

# Diretorio das plantas baixas enviadas pelo painel (padrao: data/floorplans).
FLOORPLAN_DIR="data/floorplans"

# ------------------------------------------
# Agente instalado em cada maquina (cmd/agent)
# ------------------------------------------
# Variaveis definidas NA MAQUINA monitorada, nao aqui:
#   AGENT_SERVER_URL  URL do painel central
#   AGENT_ENROLL_TOKEN  convite de uso unico, emitido no painel. O agente o troca
#                     por credencial propria no primeiro boot e a persiste em
#                     /etc/vd-agent/credential.json (modo 0600). Depois disso a
#                     variavel pode sair da configuracao.
#   AGENT_TOKEN       modo compartilhado, em descontinuacao: mesmo valor de
#                     AGENT_INGEST_TOKEN acima. So usado quando nao ha credencial
#                     nem convite.
#   AGENT_SITE        codigo da unidade (cadastrado na tela Unidades)
#   AGENT_CREDENTIAL_PATH  onde gravar a credencial (padrao
#                     /etc/vd-agent/credential.json; no Windows,
#                     %ProgramData%\vd-agent\credential.json)
#   AGENT_MACHINE_ID  sobrescreve o identificador de maquina. Por padrao sai de
#                     /etc/machine-id; hostname NAO serve, porque muda quando
#                     alguem renomeia a estacao e o historico se parte em duas.
#   AGENT_INTERVAL    segundos entre envios (padrao 5). O agente informa este
#                     valor ao painel a cada push, e o painel deriva dele a
#                     janela de tolerancia antes de dar a maquina como offline
#                     (3x o intervalo, no minimo 30s). Nao precisa configurar
#                     nada do lado do painel.

# ------------------------------------------
# Usuarios do painel
# ------------------------------------------
# Criam o primeiro administrador numa instalacao nova. Depois do primeiro
# acesso, remova ADMIN_PASSWORD daqui. Havendo qualquer usuario cadastrado
# estas variaveis sao ignoradas.
ADMIN_USER="admin"
ADMIN_PASSWORD=""

# Severidade minima que gera notificacao: info | warning | high | critical.
# Abaixo disso o alerta fica so no log. Padrao: warning.
ALERT_MIN_SEVERITY="warning"

# ------------------------------------------
# Verificacao de certificado SSL
# ------------------------------------------
# Porta e timeout do handshake TLS na tela de SSL.
SSL_CHECK_PORT="443"
SSL_CHECK_TIMEOUT="5s"

# Bundle PEM com as autoridades certificadoras internas, somado as raizes do
# sistema. A verificacao passou a conferir cadeia e hostname de verdade — antes
# so olhava a data de validade —, entao servico interno atras de CA propria
# aparece como invalido e dispara alerta ate a CA entrar aqui.
SSL_EXTRA_CA=""

# Recusa verificar dominio que resolva para endereco privado, loopback ou
# link-local. Desligado por padrao: o painel e auto-hospedado e monitorar
# servico da rede interna e o uso normal da tela de SSL. Ligue quando o painel
# ficar exposto a varios operadores e o cadastro de dominio nao puder virar
# sonda da rede onde o painel roda (SSRF).
SSL_FORBID_PRIVATE_TARGETS="false"

# Porta da API. Util para subir uma segunda instancia sem conflito.
API_ADDR=":8080"

# ------------------------------------------
# Log de auditoria
# ------------------------------------------
# Dias de retencao do audit_log, independente da retencao de metrica. O prazo e
# longo de proposito: metrica velha nao serve para nada, mas auditoria e o que
# se consulta DEPOIS do incidente — e o incidente costuma ser descoberto meses
# depois. Valor invalido ou nao-positivo cai no padrao.
AUDIT_RETENTION_DAYS="365"

# ------------------------------------------
# Retencao dos demais dados
# ------------------------------------------
# Metrica bruta e log: sete dias. E insercao a cada poucos segundos por host;
# mais que isso incha o Postgres ate degradar as consultas, e o que se olha
# depois de uma semana e a tendencia, nao a amostra.
METRIC_RETENTION_DAYS="7"
LOG_RETENTION_DAYS="7"

# Tendencia agregada por hora: pouco mais de um ano, para permitir comparar um
# mes com o mesmo mes do ano anterior. Encurtar tira a unica pergunta que a
# tabela de tendencias responde melhor que a bruta.
TREND_RETENTION_DAYS="400"

# Host do inventario sem ser visto na varredura. Curto demais apaga notebook de
# quem tirou ferias; longo demais deixa a tela cheia de maquina que nao existe.
HOST_RETENTION_DAYS="30"

# Valor invalido, zero ou negativo em qualquer um dos quatro cai no padrao com
# aviso no log: zero significaria "apagar tudo a cada passada".

# ------------------------------------------
# Coleta por SSH no host monitorado
# ------------------------------------------
# Caminhos que o painel le na maquina REMOTA. Os padroes sao de Debian e Ubuntu.
# Em RHEL o auth.log se chama /var/log/secure, e o caminho cravado deixava a tela
# de Seguranca vazia sem nenhum erro aparecer — o pior modo de falha, porque
# parece "nenhum evento" em vez de "nao consegui ler".
#
# So caminho absoluto sem espaco nem metacaractere e aceito: o valor e
# interpolado num comando que roda como root na maquina remota.
SSH_AUTH_LOG_PATH="/var/log/auth.log"
SSH_NGINX_LOG_PATH="/var/log/nginx/access.log"

# Segundos entre amostras do script de coleta. Subir alivia a CPU do host
# monitorado ao custo de granularidade na tela de tempo real.
SSH_COLLECT_INTERVAL="2"

# ------------------------------------------
# RBAC por unidade
# ------------------------------------------
# Papeis: viewer (so leitura), operator (Suporte TI: cadastra e opera dentro do
# alcance dele), admin (usuarios + servidores SSH). Sem UserSiteAccess o papel
# da conta vale globalmente; com linhas por unidade o alcance fica restrito.
# O primeiro admin sai de ADMIN_USER/ADMIN_PASSWORD acima.
