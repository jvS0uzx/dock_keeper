# Endereços dos backends COMO O NGINX OS REPORTA no campo upstream_addr.
# Se o balanceador fala com as VPS por uma rede interna (Tailscale, VPN, rede
# privada), use os endereços dessa rede — nao os publicos. Serve apenas para
# ordenar os nos do diagrama; o painel deriva os nos do trafego real, entao um
# valor errado aqui nao esconde trafego.
VITE_TARGET_VPS_IPS="10.0.0.1,10.0.0.2"

# IP do host que roda o Nginx balanceador, como cadastrado em Servidores.
# Diferente do de cima: este e comparado com servers.host_ip, nao com o
# upstream_addr do Nginx.
VITE_LB_IP="10.0.0.3"

# URL da API — SO PARA DESENVOLVIMENTO.
#
# Em producao a URL e resolvida em TEMPO DE EXECUCAO, lendo public/config.json
# ao lado do index.html. O Vite embute VITE_* no bundle, entao usar esta variavel
# em producao exigiria um build por unidade instalada; com o config.json, o mesmo
# artefato serve a todas e quem instala edita um arquivo de uma linha:
#
#   {"apiUrl": "https://painel.exemplo.com.br"}
#
# apiUrl vazio significa mesma origem, que e o caso do proxy reverso repassando
# /api — e o padrao da imagem Docker do frontend.
VITE_API_URL="http://localhost:8080"

# Token da API — EXCLUSIVO DE DESENVOLVIMENTO. Precisa bater com API_TOKEN do
# backend e serve so para o `npm run dev` nao parar na tela de login.
#
# O build de producao ignora esta variavel: o codigo so a le quando
# import.meta.env.DEV e verdadeiro, entao o valor nao chega ao bundle.
#
# O motivo e que o Vite embute no bundle tudo que o codigo le de VITE_*, e o
# backend trata este token como admin global, acima de qualquer papel. Num
# build de producao, qualquer pessoa que abrisse o DevTools sairia de la com
# acesso total ao painel, ao cadastro de servidores e as chaves SSH. Em
# producao a unica entrada e o login, que aplica papel por unidade.
VITE_API_TOKEN=""
